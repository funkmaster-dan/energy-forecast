{
  "$defs": {
    "ExportPlan": {
      "additionalProperties": false,
      "properties": {
        "safe_battery_export_remaining_kwh": {
          "default": 0,
          "minimum": 0,
          "title": "Safe Battery Export Remaining Kwh",
          "type": "number"
        },
        "safe_battery_export_now_kwh": {
          "default": 0,
          "minimum": 0,
          "title": "Safe Battery Export Now Kwh",
          "type": "number"
        },
        "advisory_export_power_kw": {
          "default": 0,
          "minimum": 0,
          "title": "Advisory Export Power Kw",
          "type": "number"
        },
        "target_path_confidence": {
          "default": 0.99,
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Target Path Confidence",
          "type": "number"
        },
        "estimated_path_confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Path Confidence"
        },
        "required_reserve_kwh": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Reserve Kwh"
        },
        "required_reserve_soc_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Reserve Soc Pct"
        },
        "source_soc_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Soc At"
        },
        "source_soc_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Soc Pct"
        },
        "replacement_budget": {
          "const": true,
          "default": true,
          "title": "Replacement Budget",
          "type": "boolean"
        },
        "conditional_on_free_charge": {
          "default": false,
          "title": "Conditional On Free Charge",
          "type": "boolean"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "schedule": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Schedule",
          "type": "array"
        },
        "shadow_candidate": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shadow Candidate"
        },
        "stress_failed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stress Failed"
        },
        "conditional_free_charge": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conditional Free Charge"
        },
        "scenario_diagnostics": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scenario Diagnostics"
        }
      },
      "title": "ExportPlan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "forecast_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Forecast Id"
    },
    "status": {
      "enum": [
        "warming_up",
        "shadow",
        "ready",
        "degraded",
        "stale",
        "invalid_configuration",
        "baseline_infeasible",
        "horizon_insufficient"
      ],
      "title": "Status",
      "type": "string"
    },
    "issued_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Issued At"
    },
    "valid_until": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid Until"
    },
    "configuration_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Configuration Hash"
    },
    "configuration_revision": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Configuration Revision"
    },
    "weather_vintage": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Weather Vintage"
    },
    "input_watermark": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Watermark"
    },
    "model_versions": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Model Versions",
      "type": "object"
    },
    "resolution_minutes": {
      "default": 60,
      "title": "Resolution Minutes",
      "type": "integer"
    },
    "horizon_hours": {
      "default": 48,
      "title": "Horizon Hours",
      "type": "integer"
    },
    "units": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Units",
      "type": "object"
    },
    "assumptions": {
      "items": {
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "series": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Series",
      "type": "array"
    },
    "totals": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Totals",
      "type": "object"
    },
    "export_plan": {
      "$ref": "#/$defs/ExportPlan"
    },
    "history_intervals": {
      "default": 0,
      "title": "History Intervals",
      "type": "integer"
    },
    "historical_replay": {
      "default": false,
      "title": "Historical Replay",
      "type": "boolean"
    },
    "observed_series": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Observed Series",
      "type": "array"
    }
  },
  "required": [
    "status",
    "export_plan"
  ],
  "title": "ForecastResponse",
  "type": "object"
}
